# =============================================================================
# FUTURES-SCOPE - Configuración (copia este archivo como .env y edítalo)
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# NUNCA subas tu .env a GitHub (ya está en .gitignore).
# =============================================================================

# --- API keys de exchanges ----------------------------------------------------
# Para LEER datos de mercado NO hacen falta (los endpoints son públicos).
# Solo se usarían en el futuro con execute_order() (hoy DESACTIVADA).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=

# Orden de preferencia de exchanges para cripto (si uno falla, prueba el siguiente
# y como último recurso usa yfinance con datos spot).
EXCHANGE_PRIORITY=binance,bybit,okx

# --- Datos ----------------------------------------------------------------------
OHLCV_LIMIT=500                 # Velas a descargar por análisis (mín. recomendado 300 por la EMA 200)
DATA_CACHE_TTL_SECONDS=20       # Caché en memoria para no saturar las APIs
REQUEST_TIMEOUT_MS=15000
DROP_INCOMPLETE_CANDLE=true     # Analizar solo velas cerradas (evita repintado)

# --- Indicadores ----------------------------------------------------------------
# auto = usa TA-Lib si está instalado, si no el motor nativo | native | talib | pandas_ta
INDICATOR_BACKEND=auto

# --- Scoring --------------------------------------------------------------------
SCORE_VALID=70                  # >= 70: setup válido (esperar confirmación)
SCORE_ALERT=85                  # >= 85: alta probabilidad -> alerta
TRACK_MIN_SCORE=70              # Score mínimo para registrar la señal en SQLite y seguirla
SIGNAL_EXPIRY_BARS=96           # Velas tras las que una señal abierta se marca EXPIRED

# --- Gestión de riesgo ------------------------------------------------------------
ACCOUNT_EQUITY=1000             # Capital de la cuenta (USDT / USD)
RISK_PER_TRADE_PCT=1.0          # % del capital arriesgado por operación
DEFAULT_LEVERAGE=5
ATR_SL_MULTIPLIER=1.5           # Stop Loss = ATR x 1.5 (o debajo del Order Block)
TP1_RR=2.0                      # Take Profit 1 en 1:2
TP2_RR=3.0                      # Take Profit 2 en 1:3
KILL_SWITCH_LOSSES=3            # Pérdidas consecutivas que pausan el bot
TAKER_FEE_PCT=0.05              # Comisión estimada por lado (Binance Futures taker ~0.05%)

# --- Filtro de noticias ---------------------------------------------------------
NEWS_FILTER_ENABLED=true
NEWS_WINDOW_MINUTES=30          # No operar 30 min antes / después de noticias de alto impacto
NEWS_CURRENCIES=USD             # Monedas cuyas noticias afectan (USD mueve cripto e índices)
NEWS_API_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Calendario manual adicional: data/news_calendar.json

# --- Análisis de contexto (macro, social, político, cultural) -------------------
CONTEXT_ENABLED=true
CONTEXT_MAX_ADJUST=8            # Puntos máximos que el contexto suma/resta al score técnico (0 = desactivar)
CONTEXT_CACHE_MINUTES=15
CONTEXT_NEWS_LANG=es            # Idioma de titulares de Google News: es | en

# --- Alertas (opcional) -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=              # Webhook genérico (Discord / Slack) opcional

# --- Extras -----------------------------------------------------------------------
USE_TRADINGVIEW_TA=false        # Consenso de TradingView como información extra (no afecta el score)
LOG_LEVEL=INFO
DB_PATH=data/futures_scope.db
